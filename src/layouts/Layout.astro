---
import { site } from "../data/site";
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
  image?: string;
  noindex?: boolean;
}

const {
  title = `${site.shortName} | Repostería y Snacks`,
  description = site.description,
  image = "/social-card.svg",
  noindex = false,
} = Astro.props;

const canonical = Astro.site ? new URL(Astro.url.pathname, Astro.site) : null;
const socialImage = Astro.site ? new URL(image, Astro.site) : null;
const structuredData = {
  "@context": "https://schema.org",
  "@type": "Bakery",
  name: site.name,
  description: site.description,
  email: site.email,
  telephone: "+52 644 226 6088",
  areaServed: site.serviceArea,
  address: {
    "@type": "PostalAddress",
    addressLocality: "Ciudad Obregón",
    addressRegion: "Sonora",
    addressCountry: "MX",
  },
  paymentAccepted: site.payment,
  openingHoursSpecification: [
    {
      "@type": "OpeningHoursSpecification",
      dayOfWeek: ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday"],
      opens: "09:00",
      closes: "19:00",
    },
    {
      "@type": "OpeningHoursSpecification",
      dayOfWeek: "Sunday",
      opens: "09:00",
      closes: "13:00",
    },
  ],
  url: canonical?.href,
  sameAs: [site.instagramUrl],
};
---

<!doctype html>
<html lang="es-MX" data-theme="light">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#fcfbf7" id="theme-color" />
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    {canonical && <link rel="canonical" href={canonical} />}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <meta property="og:type" content="website" />
    <meta property="og:locale" content="es_MX" />
    <meta property="og:site_name" content={site.shortName} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {canonical && <meta property="og:url" content={canonical} />}
    {socialImage && <meta property="og:image" content={socialImage} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    {socialImage && <meta name="twitter:image" content={socialImage} />}

    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />
    <script is:inline>
      (() => {
        const savedTheme = localStorage.getItem("bavette-theme");
        const theme = savedTheme === "dark" ? "dark" : "light";
        document.documentElement.dataset.theme = theme;
        document.documentElement.style.colorScheme = theme;
        document.querySelector("#theme-color")?.setAttribute(
          "content",
          theme === "dark" ? "#201a19" : "#fcfbf7",
        );
      })();
    </script>
  </head>
  <body>
    <slot />
  </body>
</html>
