---
import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";
import { site, whatsappUrl } from "../data/site";
import Layout from "../layouts/Layout.astro";

const products = [
  {
    name: "Pasteles personalizados",
    use: "Para celebrar",
    detail: "Sabores, rellenos, tamaños y porciones por confirmar.",
    price: "Precio inicial por confirmar",
    image:
      "https://images.unsplash.com/photo-1578985545062-69928b1d9587?auto=format&fit=crop&w=1000&q=82",
    alt: "Pastel de chocolate decorado con fresas, imagen de referencia",
  },
  {
    name: "Cupcakes personalizados",
    use: "Para compartir",
    detail: "Sabores, decoraciones, presentaciones y pedido mínimo por confirmar.",
    price: "Precio por pieza por confirmar",
    image:
      "https://images.unsplash.com/photo-1559622214-f8a9850965bb?auto=format&fit=crop&w=900&q=82",
    alt: "Cupcakes personalizados y decorados, imagen de referencia",
  },
  {
    name: "Servicio de café",
    use: "Para reunir",
    detail: "Paquetes, bebidas, montaje, capacidad y cobertura por confirmar.",
    price: "Cotización por confirmar",
    image:
      "https://images.unsplash.com/photo-1495474472287-4d71bcdd2085?auto=format&fit=crop&w=900&q=82",
    alt: "Preparación de café, imagen de referencia",
  },
];

const facts = [
  ["Dónde", `${site.city} · ${site.serviceArea}`],
  ["Cuándo pedir", site.leadTime],
  ["Cómo recibes", site.delivery],
  ["Cómo pagas", site.payment],
];

const faqs = [
  [
    "¿Con cuánta anticipación debo pedir?",
    `${site.leadTime}. Para fechas especiales recomendamos consultar disponibilidad lo antes posible.`,
  ],
  [
    "¿Hacen diseños personalizados?",
    "Sí, cuéntanos la ocasión, el estilo que imaginas y para cuántas personas es. Confirmaremos qué podemos realizar antes de cotizar.",
  ],
  [
    "¿Tienen opciones para alergias o dietas especiales?",
    "Ingredientes, alérgenos y medidas contra contaminación cruzada están por confirmar. No hagas un pedido para una alergia severa sin consultarlo primero.",
  ],
  [
    "¿Hay entrega a domicilio?",
    `${site.delivery}. La dirección y el horario se confirman al hacer el pedido.`,
  ],
  [
    "¿Cómo se aparta una fecha?",
    `${site.payment}. Tu fecha queda confirmada únicamente cuando recibes la confirmación de Bavette.`,
  ],
];
---

<Layout>
  <a class="skip-link" href="#contenido">Saltar al contenido</a>
  <Header />

  <main id="contenido">
    <section class="hero" id="inicio">
      <div class="hero-copy">
        <p class="eyebrow">Hecho para consentir</p>
        <h1>Un pedacito<br />de felicidad.</h1>
        <p class="hero-intro">
          Pasteles y cupcakes personalizados, además de servicio de café, para
          los días que merecen una cereza encima.
        </p>
        <div class="hero-actions">
          <a class="button button-pink" href="#encargos">Prepara tu pedido</a>
          <a class="text-link" href="#menu">Conoce el menú <span aria-hidden="true">↓</span></a>
        </div>
      </div>

      <figure class="hero-visual">
        <div class="hero-flower" aria-hidden="true"></div>
        <img
          src="https://images.unsplash.com/photo-1578985545062-69928b1d9587?auto=format&fit=crop&w=1200&q=85"
          alt="Pastel de chocolate decorado con fresas, imagen de referencia"
          width="1200"
          height="800"
          fetchpriority="high"
        />
        <figcaption>Fotografía temporal · reemplazar con producto Bavette</figcaption>
        <div class="hero-stamp" aria-hidden="true">Hecho con<br /><em>mucho amor</em></div>
      </figure>
    </section>

    <section class="intro-section" id="nosotras" aria-labelledby="intro-title">
      <p class="script-mark" aria-hidden="true">B</p>
      <div>
        <p class="eyebrow eyebrow-dark">Una cocina pequeñita</p>
        <h2 id="intro-title">Momentos bonitos, servidos en un plato.</h2>
      </div>
      <p>
        En Bavette hacemos postres para acompañar celebraciones, sobremesas y
        regalos. Cada pedido se prepara especialmente para su fecha.
      </p>
    </section>

    <section class="menu-section" id="menu" aria-labelledby="menu-title">
      <div class="section-heading">
        <div>
          <p class="eyebrow">Menú por encargo</p>
          <h2 id="menu-title">Elige tu antojo</h2>
        </div>
        <p>
          Esta es una muestra temporal. Sabores, presentaciones y precios se
          actualizarán con el menú confirmado por Bavette.
        </p>
      </div>

      <div class="product-grid">
        {products.map((product) => (
          <article class="product-card">
            <div class="product-image">
              <img
                src={product.image}
                alt={product.alt}
                width="900"
                height="1100"
                loading="lazy"
              />
              <span>Imagen de referencia</span>
            </div>
            <div class="product-content">
              <p>{product.use}</p>
              <h3>{product.name}</h3>
              <p>{product.detail}</p>
              <strong>{product.price}</strong>
              <a href="#encargos">Consultar {product.name.toLowerCase()} <span aria-hidden="true">→</span></a>
            </div>
          </article>
        ))}
      </div>

      <p class="allergen-note">
        <strong>Antes de ordenar:</strong> pregunta por ingredientes y alérgenos.
        La información final de manejo y contaminación cruzada está pendiente de
        confirmación.
      </p>
    </section>

    <section class="order-section" id="encargos" aria-labelledby="order-title">
      <div class="order-copy">
        <p class="eyebrow">Tu idea, nuestro horno</p>
        <h2 id="order-title">Hagamos algo especial.</h2>
        <p>
          Completa lo esencial y te ayudamos a convertirlo en un mensaje claro
          para solicitar disponibilidad y cotización.
        </p>
        <ol class="steps">
          <li><b>01</b><span>Cuéntanos qué quieres celebrar</span></li>
          <li><b>02</b><span>Confirma fecha, porciones y entrega</span></li>
          <li><b>03</b><span>Recibe cotización y aparta tu fecha</span></li>
        </ol>
      </div>

      <form class="order-form" id="order-form">
        <div class="form-row">
          <label>
            Tu nombre
            <input name="nombre" autocomplete="name" required />
          </label>
          <label>
            Fecha del evento
            <input name="fecha" type="date" required />
          </label>
        </div>
        <div class="form-row">
          <label>
            ¿Qué te interesa?
            <select name="producto" required>
              <option value="">Selecciona una opción</option>
              <option>Pastel personalizado</option>
              <option>Cupcakes personalizados</option>
              <option>Servicio de café</option>
              <option>Pastel y cupcakes</option>
            </select>
          </label>
          <label>
            Número de personas
            <input name="personas" type="number" min="1" inputmode="numeric" required />
          </label>
        </div>
        <label>
          Cuéntanos tu idea
          <textarea
            name="idea"
            rows="4"
            placeholder="Ocasión, sabores, estilo, colores y cualquier detalle importante"
            required></textarea>
        </label>
        <button class="button button-pink" type="submit">Preparar mensaje</button>
        <p class="form-help">
          Este formulario no envía datos. Genera un texto para que lo revises y
          lo compartas por el canal de contacto.
        </p>

        <div class="message-result" id="message-result" hidden>
          <label>
            Tu mensaje
            <textarea id="prepared-message" rows="8" readonly></textarea>
          </label>
          <div class="message-actions">
            <button class="button button-light" id="copy-message" type="button">Copiar mensaje</button>
            <a
              class="button button-outline"
              href={whatsappUrl || site.instagramUrl}
              target="_blank"
              rel="noreferrer"
            >
              Abrir {whatsappUrl ? "WhatsApp" : "Instagram"} <span aria-hidden="true">↗</span>
              <span class="sr-only">(se abre en una pestaña nueva)</span>
            </a>
          </div>
          <p class="copy-status" id="copy-status" role="status" aria-live="polite"></p>
        </div>
      </form>
    </section>

    <section class="facts-section" aria-labelledby="facts-title">
      <div class="section-heading compact">
        <div>
          <p class="eyebrow eyebrow-dark">Antes de pedir</p>
          <h2 id="facts-title">Lo práctico, sin vueltas.</h2>
        </div>
        <p>Estos datos deben ser confirmados por Bavette antes de publicar.</p>
      </div>
      <dl class="facts-grid">
        {facts.map(([term, description]) => (
          <div>
            <dt>{term}</dt>
            <dd>{description}</dd>
          </div>
        ))}
      </dl>
    </section>

    <section class="proof-section" aria-labelledby="proof-title">
      <div>
        <p class="eyebrow">Historias de sobremesa</p>
        <h2 id="proof-title">Lo que dicen quienes ya probaron.</h2>
      </div>
      <article class="testimonial-placeholder">
        <span aria-hidden="true">“</span>
        <p>Testimonio real pendiente de autorización.</p>
        <small>Nombre del cliente · tipo de pedido</small>
      </article>
      <article class="testimonial-placeholder">
        <span aria-hidden="true">“</span>
        <p>Testimonio real pendiente de autorización.</p>
        <small>Nombre del cliente · tipo de pedido</small>
      </article>
    </section>

    <section class="faq-section" id="preguntas" aria-labelledby="faq-title">
      <div class="faq-heading">
        <p class="eyebrow eyebrow-dark">Preguntas frecuentes</p>
        <h2 id="faq-title">Antes de encender el horno.</h2>
        <p>Si tu duda no aparece aquí, escríbenos y la resolvemos contigo.</p>
      </div>
      <div class="faq-list">
        {faqs.map(([question, answer]) => (
          <details>
            <summary>{question}<span aria-hidden="true">+</span></summary>
            <p>{answer}</p>
          </details>
        ))}
      </div>
    </section>

    <section class="contact-section" id="contacto" aria-labelledby="contact-title">
      <p class="eyebrow eyebrow-dark">Algo dulce está por pasar</p>
      <h2 id="contact-title">Nos vemos<br /><em>en la mesa.</em></h2>
      <p>Consulta disponibilidad antes de hacer cualquier pago.</p>
      <div class="contact-actions">
        <a class="button button-dark" href={site.instagramUrl} target="_blank" rel="noreferrer">
          {site.instagramHandle} <span aria-hidden="true">↗</span>
          <span class="sr-only">(se abre en una pestaña nueva)</span>
        </a>
        {whatsappUrl ? (
          <a class="button button-outline-dark" href={whatsappUrl} target="_blank" rel="noreferrer">
            WhatsApp <span aria-hidden="true">↗</span>
            <span class="sr-only">(se abre en una pestaña nueva)</span>
          </a>
        ) : (
          <span class="pending-contact">WhatsApp pendiente de confirmar</span>
        )}
      </div>
      <address>
        {site.city} · {site.address}<br />{site.hours} · {site.responseTime}
        <br /><a href={`mailto:${site.email}`}>{site.email}</a>
      </address>
    </section>
  </main>

  <a class="mobile-order" href="#encargos">Preparar pedido</a>
  <Footer />

  <script>
    const form = document.querySelector<HTMLFormElement>("#order-form");
    const result = document.querySelector<HTMLElement>("#message-result");
    const message = document.querySelector<HTMLTextAreaElement>("#prepared-message");
    const copyButton = document.querySelector<HTMLButtonElement>("#copy-message");
    const copyStatus = document.querySelector<HTMLElement>("#copy-status");

    form?.addEventListener("submit", (event) => {
      event.preventDefault();
      const data = new FormData(form);
      const dateValue = String(data.get("fecha") || "");
      const date = dateValue
        ? new Intl.DateTimeFormat("es", { dateStyle: "long", timeZone: "UTC" }).format(
            new Date(`${dateValue}T00:00:00Z`),
          )
        : "por confirmar";

      if (!message || !result) return;
      message.value = [
        "¡Hola, Bavette! Quisiera consultar disponibilidad y cotización.",
        `Nombre: ${data.get("nombre")}`,
        `Fecha: ${date}`,
        `Producto: ${data.get("producto")}`,
        `Personas: ${data.get("personas")}`,
        `Idea: ${data.get("idea")}`,
      ].join("\n");
      result.hidden = false;
      result.scrollIntoView({ behavior: "smooth", block: "nearest" });
    });

    copyButton?.addEventListener("click", async () => {
      if (!message || !copyStatus) return;
      try {
        await navigator.clipboard.writeText(message.value);
        copyStatus.textContent = "Mensaje copiado. Ya puedes compartirlo.";
      } catch {
        message.select();
        copyStatus.textContent = "Selecciona el texto y cópialo manualmente.";
      }
    });
  </script>
</Layout>
