---
import Layout from '../layouts/Layout.astro';

const instagram = 'https://www.instagram.com/bavettereposteria/';
const buttonClass = 'inline-flex items-center gap-5 rounded-sm bg-petal px-[18px] py-[15px] font-display text-xs font-bold text-cocoa transition motion-reduce:transition-none hover:-translate-y-[3px] hover:bg-icing active:translate-y-px';
---

<Layout>
  <main>
    <section class="relative min-h-[790px] overflow-hidden bg-cocoa px-6 pb-[68px] pt-6 md:min-h-[810px] md:px-[clamp(24px,5vw,76px)]" id="inicio">
      <nav class="relative z-10 mx-auto flex h-16 max-w-[1400px] items-center justify-between gap-7" aria-label="Navegacion principal">
        <a class="grid text-[9px] leading-[1.4] tracking-[.14em] text-petal uppercase" href="#inicio" aria-label="Bavette, inicio"><span class="font-script text-[25px] leading-none tracking-[-2px] normal-case">Bavette</span><span>Reposteria y snacks</span></a>
        <div class="hidden gap-[30px] text-[13px] text-blush md:flex"><a class="hover:text-petal" href="#antojos">Antojos</a><a class="hover:text-petal" href="#encargos">Encargos</a><a class="hover:text-petal" href="#nosotras">Bavette</a></div>
        <a class="border-b border-petal pb-[5px] text-[10px] whitespace-nowrap hover:text-petal md:text-xs" href={instagram} target="_blank" rel="noreferrer">Pide por Instagram <span aria-hidden="true">&#8599;</span></a>
      </nav>

      <div class="relative z-[1] mt-[90px] max-w-[610px] md:ml-[max(2vw,calc((100vw-1260px)/2))] md:mt-[130px]">
        <p class="mb-[18px] font-display text-[10px] font-bold tracking-[.16em] text-petal uppercase">Hecho para consentir</p>
        <h1 class="font-display text-[clamp(52px,15vw,75px)] leading-[.89] font-bold tracking-[-.07em] md:text-[clamp(57px,7.4vw,112px)]">Un pedacito<br />de felicidad.</h1>
        <p class="my-[30px] max-w-[390px] text-base leading-[1.55] text-blush">Pasteles, postres y detalles dulces para los dias que merecen una cereza encima.</p>
        <a class={buttonClass} href={instagram} target="_blank" rel="noreferrer">Pide por Instagram <span aria-hidden="true">&#8599;</span></a>
      </div>

      <div class="absolute -right-5 -bottom-[21px] aspect-[.92] w-[83vw] md:right-[max(4vw,calc((100vw-1400px)/2))] md:-bottom-[42px] md:w-[min(45vw,610px)]" aria-label="Pastel Bavette con cerezas">
        <div class="absolute -top-[3%] -left-[5%] z-[2] h-[41%] w-[65%] rotate-[28deg] rounded-[50%] border-t-8 border-bark"></div><div class="absolute top-[8%] left-[12%] z-[2] h-[41%] w-[34%] rotate-[105deg] rounded-[50%] border-t-[5px] border-bark"></div>
        <div class="absolute top-[8%] left-[24%] z-[3] h-[50px] w-[50px] rounded-[48%_52%_45%_55%] bg-petal shadow-[20px_7px_0_-6px_#f8bdd4,8px_23px_0_-6px_#ef89b6,-13px_16px_0_-7px_#f8bdd4]"></div><div class="absolute top-[16%] left-[45%] z-[3] h-[50px] w-[50px] scale-[.72] rounded-[48%_52%_45%_55%] bg-petal shadow-[20px_7px_0_-6px_#f8bdd4,8px_23px_0_-6px_#ef89b6,-13px_16px_0_-7px_#f8bdd4]"></div><div class="absolute top-[1%] left-[55%] z-[3] h-[50px] w-[50px] scale-50 rounded-[48%_52%_45%_55%] bg-petal shadow-[20px_7px_0_-6px_#f8bdd4,8px_23px_0_-6px_#ef89b6,-13px_16px_0_-7px_#f8bdd4]"></div>
        <img class="absolute right-[4%] bottom-[8%] h-[79%] w-[74%] rounded-[50%_50%_46%_46%/44%_44%_56%_56%] object-cover object-[52%_50%] saturate-[.83] contrast-105" src="https://images.unsplash.com/photo-1578985545062-69928b1d9587?auto=format&fit=crop&w=1200&q=85" alt="Pastel de chocolate decorado con fresas" />
        <div class="pointer-events-none absolute right-[-2%] bottom-[3%] h-[84%] w-[76%] rotate-[9deg] rounded-[53%_46%_56%_44%/48%_51%_46%_52%] border border-petal"></div>
        <div class="absolute bottom-[13%] left-[2%] z-[1] grid h-[135px] w-[135px] -rotate-[12deg] place-content-center rounded-full bg-berry text-center font-display text-[11px] leading-[1.3] tracking-[.03em]">Hecho con<br /><em class="font-script text-base">mucho amor</em></div>
      </div>
      <div class="absolute bottom-[37px] left-[clamp(24px,5vw,76px)] hidden font-display text-[10px] leading-[1.4] tracking-[.12em] text-[#c994a9] uppercase md:block">Desliza para abrir<br />la caja de antojos <span class="ml-2 text-lg" aria-hidden="true">&#8595;</span></div>
    </section>

    <section class="grid gap-[25px] bg-petal px-6 py-[78px] text-cocoa md:grid-cols-[.5fr_2.3fr_1.3fr] md:gap-[55px] md:px-[clamp(24px,9vw,170px)] md:py-[130px]" id="nosotras">
      <p class="hidden -rotate-[12deg] font-script text-[78px] leading-[.6] md:block">B</p>
      <div><p class="mb-[18px] font-display text-[10px] font-bold tracking-[.16em] text-mauve uppercase">Una cocina pequeñita</p><h2 class="max-w-[740px] font-display text-[clamp(34px,4vw,63px)] leading-[.98] tracking-[-.07em]">De esas que huelen a mantequilla, vainilla y planes bonitos.</h2></div>
      <p class="max-w-[320px] text-[15px] leading-[1.6]">En Bavette hacemos postres para acompañar tus momentos favoritos. Cada pedido se prepara con calma, ingredientes ricos y el toque rosa de la casa.</p>
    </section>

    <section class="bg-icing px-6 py-[82px] text-cocoa md:px-[clamp(24px,7vw,130px)] md:py-[132px]" id="antojos">
      <div class="mb-12 block md:flex md:items-end md:justify-between md:gap-[45px]"><div><p class="mb-[18px] font-display text-[10px] font-bold tracking-[.16em] text-petal uppercase">La vitrina de hoy</p><h2 class="font-display text-[clamp(42px,5vw,75px)] leading-[.95] tracking-[-.07em]">Elige tu antojo</h2></div><p class="mt-5 max-w-[270px] text-sm leading-[1.5] md:mt-0">Sabores que cambian con la temporada. Pregunta por disponibilidad al hacer tu pedido.</p></div>
      <div class="mx-auto grid max-w-[1270px] grid-cols-1 items-end gap-[18px] md:grid-cols-[1.22fr_.9fr_.9fr]">
        <article class="group relative flex min-h-[405px] items-end overflow-hidden text-icing md:min-h-[585px]"><img class="absolute inset-0 h-full w-full object-cover transition duration-500 motion-reduce:transition-none group-hover:scale-[1.04]" src="https://images.unsplash.com/photo-1551024506-0bccd828d307?auto=format&fit=crop&w=1000&q=85" alt="Rebanada de pastel con glaseado" loading="lazy" /><div class="absolute inset-x-0 bottom-0 top-[40%] bg-linear-to-b from-transparent to-[rgba(52,38,31,.8)]"></div><div class="relative z-[1] p-7"><span class="text-[10px] tracking-[.13em] uppercase">Para celebrar</span><h3 class="my-[8px] mb-[18px] font-display text-[37px] tracking-[-.07em]">Pasteles</h3><a class="border-b pb-1 text-xs" href={instagram} target="_blank" rel="noreferrer">Ver opciones <span class="ml-[14px]" aria-hidden="true">&#8599;</span></a></div></article>
        <article class="group relative flex min-h-[405px] items-end overflow-hidden text-cocoa md:min-h-[430px]"><img class="absolute inset-0 h-full w-full object-cover transition duration-500 motion-reduce:transition-none group-hover:scale-[1.04]" src="https://images.unsplash.com/photo-1559622214-f8a9850965bb?auto=format&fit=crop&w=900&q=85" alt="Cupcakes con betun" loading="lazy" /><div class="absolute inset-x-0 bottom-0 top-[40%] bg-linear-to-b from-transparent to-[rgba(243,161,197,.94)]"></div><div class="relative z-[1] p-7"><span class="text-[10px] tracking-[.13em] uppercase">Para compartir</span><h3 class="my-[8px] mb-[18px] font-display text-[37px] tracking-[-.07em]">Mini postres</h3><a class="border-b pb-1 text-xs" href={instagram} target="_blank" rel="noreferrer">Ver opciones <span class="ml-[14px]" aria-hidden="true">&#8599;</span></a></div></article>
        <article class="group relative flex min-h-[405px] items-end overflow-hidden text-cocoa md:min-h-[430px]"><img class="absolute inset-0 h-full w-full object-cover transition duration-500 motion-reduce:transition-none group-hover:scale-[1.04]" src="https://images.unsplash.com/photo-1488477181946-6428a0291777?auto=format&fit=crop&w=900&q=85" alt="Galletas recien horneadas" loading="lazy" /><div class="absolute inset-x-0 bottom-0 top-[40%] bg-linear-to-b from-transparent to-[rgba(255,246,250,.95)]"></div><div class="relative z-[1] p-7"><span class="text-[10px] tracking-[.13em] uppercase">Para el antojo</span><h3 class="my-[8px] mb-[18px] font-display text-[37px] tracking-[-.07em]">Snacks</h3><a class="border-b pb-1 text-xs" href={instagram} target="_blank" rel="noreferrer">Ver opciones <span class="ml-[14px]" aria-hidden="true">&#8599;</span></a></div></article>
      </div>
    </section>

    <section class="grid min-h-[690px] grid-cols-1 bg-cocoa md:grid-cols-2" id="encargos">
      <div class="overflow-hidden"><img class="min-h-[410px] h-full w-full object-cover saturate-[.8] md:min-h-[690px]" src="https://images.unsplash.com/photo-1535141192574-5d4897c12636?auto=format&fit=crop&w=1100&q=85" alt="Pastel rosa para una celebracion" loading="lazy" /></div>
      <div class="self-center px-[clamp(30px,7vw,110px)] py-[80px] md:py-[110px]"><p class="mb-[18px] font-display text-[10px] font-bold tracking-[.16em] text-mauve uppercase">Tu idea, nuestro horno</p><h2 class="font-display text-[clamp(42px,5vw,75px)] leading-[.95] tracking-[-.07em]">Hagamos algo especial.</h2><p class="my-[25px] mb-[35px] max-w-[400px] text-[15px] leading-[1.6] text-blush">Cuéntanos qué estás celebrando, para cuántas personas y cuándo lo necesitas. Te ayudamos a elegir el postre perfecto.</p><ol class="mb-[35px] border-t border-line"><li class="flex gap-5 border-b border-line py-[14px] text-[13px]"><b class="font-display text-[11px] text-petal">01</b><span>Escríbenos por Instagram</span></li><li class="flex gap-5 border-b border-line py-[14px] text-[13px]"><b class="font-display text-[11px] text-petal">02</b><span>Cuéntanos tu idea y fecha</span></li><li class="flex gap-5 border-b border-line py-[14px] text-[13px]"><b class="font-display text-[11px] text-petal">03</b><span>Recoge tu pedido y disfruta</span></li></ol><a class={`${buttonClass} bg-icing`} href={instagram} target="_blank" rel="noreferrer">Pide por Instagram <span aria-hidden="true">&#8599;</span></a></div>
    </section>

    <section class="relative grid min-h-[470px] place-content-center overflow-hidden bg-berry px-6 py-[120px] text-center md:min-h-[550px]"><div class="absolute -bottom-80 -left-[50px] h-[530px] w-[530px] rotate-[6deg] rounded-tr-full border-[15px] border-b-0 border-l-0 border-cocoa opacity-95"><i class="absolute -top-[37px] right-[110px] h-16 w-16 rounded-[50%_45%_55%_45%] bg-petal"></i><i class="absolute top-[88px] right-[7px] h-16 w-16 scale-75 rounded-[50%_45%_55%_45%] bg-petal"></i><i class="absolute top-[170px] right-10 h-16 w-16 scale-50 rounded-[50%_45%_55%_45%] bg-petal"></i></div><p class="relative mb-[18px] font-display text-[10px] font-bold tracking-[.16em] text-cocoa uppercase">Algo dulce esta por pasar</p><h2 class="relative font-display text-[clamp(59px,7vw,110px)] leading-[.95] tracking-[-.07em] text-icing">Nos vemos<br /><em class="inline-block px-[.15em] pt-[.12em] pb-[.18em] font-script text-[.72em] tracking-[-.12em]">en la mesa.</em></h2><a class="relative mx-auto mt-[22px] border-b border-cocoa pb-1 text-[13px] text-cocoa" href={instagram} target="_blank" rel="noreferrer">@bavettereposteria <span aria-hidden="true">&#8599;</span></a></section>
  </main>
  <footer class="flex justify-between gap-5 bg-cocoa px-[clamp(24px,5vw,76px)] py-[19px] text-[8px] tracking-[.12em] text-[#c994a9] uppercase md:text-[10px]"><span>Bavette Reposteria y Snacks</span><span>Hecho con mucho amor</span></footer>
</Layout>
