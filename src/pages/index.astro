---
import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";
import { site, whatsappMessageUrl, whatsappOrderUrl } from "../data/site";
import Layout from "../layouts/Layout.astro";

const products = [
  {
    name: "Pasteles personalizados",
    label: "Para celebrar",
    detail: "Diseños pensados para tu ocasión, desde 5 personas hasta 300.",
    minimum: "Desde 5 personas",
    image:
      "https://images.unsplash.com/photo-1578985545062-69928b1d9587?auto=format&fit=crop&w=1200&q=85",
    alt: "Pastel decorado con fresas, imagen de referencia",
    featured: true,
  },
  {
    name: "Cupcakes",
    label: "Para compartir",
    detail: "Pequeños detalles personalizados para mesas dulces, regalos y reuniones.",
    minimum: "Pedido mínimo de 6",
    image:
      "https://images.unsplash.com/photo-1559622214-f8a9850965bb?auto=format&fit=crop&w=1000&q=85",
    alt: "Cupcakes decorados, imagen de referencia",
    featured: false,
  },
  {
    name: "Servicio de café",
    label: "Para reunir",
    detail: "Una opción dulce para acompañar reuniones y eventos especiales.",
    minimum: "Cotización para tu evento",
    image:
      "https://images.unsplash.com/photo-1495474472287-4d71bcdd2085?auto=format&fit=crop&w=1000&q=85",
    alt: "Taza de café, imagen de referencia",
    featured: false,
  },
  {
    name: "Quesos para eventos",
    label: "Para disfrutar",
    detail: "Quesos preparados para compartir en celebraciones y reuniones.",
    minimum: "Desde 1 queso preparado",
    image:
      "https://images.unsplash.com/photo-1452195100486-9cc805987862?auto=format&fit=crop&w=1000&q=85",
    alt: "Tabla con quesos, imagen de referencia",
    featured: false,
  },
];

const whatsappProductUrl = (productName: string) =>
  whatsappMessageUrl(
    `Hola, Bavette. Me interesa ${productName}. Quiero solicitar disponibilidad y cotización.`,
  );

const breads = ["Vainilla", "Chocolate", "Red velvet", "Fresa", "Zanahoria", "Piña", "Tres leches"];
const fillings = ["Cajeta", "Mermelada", "Bavaria", "Nutella", "Fresas con crema"];

const facts = [
  ["Zona", site.serviceArea],
  ["Anticipación", `Mínimo de ${site.leadTime}`],
  ["Respuesta", site.responseTime],
  ["Anticipo", site.deposit],
];

const faqs = [
  [
    "¿Con cuánta anticipación debo pedir?",
    "Solicita tu pedido con al menos 48 horas de anticipación. Para bodas y XV años, los cambios o cancelaciones deben realizarse una semana antes del evento.",
  ],
  [
    "¿Aceptan pedidos urgentes?",
    "Sí, únicamente cuando sea posible trabajar con decorado de chantilly y con el sabor de pan disponible. Escríbenos para revisar la fecha.",
  ],
  [
    "¿Hacen entregas a domicilio?",
    `${site.delivery}. Trabajamos desde casa, por lo que no contamos con un local abierto al público para recoger pedidos.`,
  ],
  [
    "¿Qué métodos de pago aceptan?",
    `${site.payment}. Para apartar la fecha se requiere un anticipo del 50%.`,
  ],
  [
    "¿Puedo cambiar o cancelar mi pedido?",
    "Los cambios y cancelaciones se solicitan con 48 horas de anticipación. En pasteles para bodas o XV años, el plazo es de una semana antes del evento.",
  ],
  [
    "¿Tienen opciones para alergias o dietas especiales?",
    "La ficha de ingredientes, alérgenos y opciones dietéticas está pendiente de confirmación. Si tienes una alergia, escríbenos antes de confirmar tu pedido.",
  ],
];
---

<Layout>
  <a class="skip-link" href="#contenido">Saltar al contenido</a>
  <Header />

  <main id="contenido">
    <section class="hero" id="inicio" aria-labelledby="hero-title">
      <div class="hero-copy">
        <p class="eyebrow">Pastelería personalizada en Ciudad Obregón</p>
        <h1 id="hero-title">Algo bonito para celebrar.</h1>
        <p class="hero-intro">
          Pasteles, cupcakes y detalles preparados para que tu fecha se sienta todavía más especial.
        </p>
        <div class="hero-actions">
          <a class="button button-accent" href={whatsappOrderUrl} target="_blank" rel="noreferrer">
            Escribir por WhatsApp <span aria-hidden="true">↗</span>
            <span class="sr-only">(se abre en una pestaña nueva)</span>
          </a>
          <a class="text-link" href="#menu">Ver opciones <span aria-hidden="true">↓</span></a>
        </div>
      </div>

      <figure class="hero-visual">
        <div class="hero-image-wrap">
          <img
            src="/images/hero-cake.png"
            alt="Pastel de celebración con cupcakes, imagen editorial de referencia"
            width="1672"
            height="941"
            fetchpriority="high"
          />
        </div>
        <figcaption>Imagen editorial de referencia. Fotos originales de Bavette por agregar.</figcaption>
        <div class="hero-badge" aria-label="Pasteles personalizados desde 5 personas">
          <strong>Desde 5</strong>
          <span>personas</span>
        </div>
      </figure>
    </section>

    <section class="story-section" id="nosotras" aria-labelledby="story-title">
      <div class="story-years" aria-label="Seis años de experiencia">
        <strong>6</strong>
        <span>años creando</span>
      </div>
      <div class="story-copy">
        <p class="eyebrow eyebrow-dark">La historia de Bavette</p>
        <h2 id="story-title">Una inquietud que se convirtió en celebración.</h2>
        <p>
          Bavette Repostería y Snacks nació de las ganas de brindar opciones únicas, hechas de acuerdo con los gustos y detalles de cada cliente.
        </p>
        <p>
          Nos motiva acompañarte en tus mejores momentos con creaciones preparadas especialmente para tu fecha.
        </p>
      </div>
    </section>

    <section class="menu-section" id="menu" aria-labelledby="menu-title">
      <div class="section-heading">
        <div>
          <p class="eyebrow eyebrow-dark">Menú por encargo</p>
          <h2 id="menu-title">El antojo empieza aquí.</h2>
        </div>
        <p>
          Nuestros productos están disponibles todo el año. Los precios se cotizan según el diseño, tamaño y cantidad.
        </p>
      </div>

      <div class="product-grid">
        {products.map((product) => (
          <article class:list={["product-card", product.featured && "product-card-featured"]}>
            <div class="product-media">
              <img src={product.image} alt={product.alt} width="1000" height="900" loading="lazy" />
              <p>Imagen de referencia</p>
            </div>
            <div class="product-content">
              <p class="product-label">{product.label}</p>
              <h3>{product.name}</h3>
              <p class="product-detail">{product.detail}</p>
              <div class="product-meta">
                <span>{product.minimum}</span>
                <span>Precio por cotizar</span>
              </div>
              <a href={whatsappProductUrl(product.name)} target="_blank" rel="noreferrer">
                Pedir por WhatsApp <span aria-hidden="true">↗</span>
                <span class="sr-only">(se abre en una pestaña nueva)</span>
              </a>
            </div>
          </article>
        ))}
      </div>

      <p class="allergen-note">
        <strong>¿Tienes una alergia?</strong> La información de ingredientes, alérgenos y contaminación cruzada está pendiente de confirmación. Consúltanos antes de ordenar.
      </p>
    </section>

    <section class="flavors-section" id="sabores" aria-labelledby="flavors-title">
      <div class="flavors-intro">
        <p class="eyebrow">Para personalizar</p>
        <h2 id="flavors-title">Elige la combinación que se te antoje.</h2>
        <p>Estos son los sabores de pan y rellenos disponibles para tus pasteles. La disponibilidad se confirma al cotizar.</p>
      </div>

      <div class="flavor-groups">
        <div class="flavor-group">
          <p class="flavor-index">Pan</p>
          <ul>
            {breads.map((bread) => <li>{bread}</li>)}
          </ul>
        </div>
        <div class="flavor-group">
          <p class="flavor-index">Rellenos</p>
          <ul>
            {fillings.map((filling) => <li>{filling}</li>)}
          </ul>
        </div>
      </div>

      <aside class="urgent-note">
        <p class="eyebrow eyebrow-dark">¿Lo necesitas pronto?</p>
        <h3>Pedidos urgentes</h3>
        <p>Solo con decorado de chantilly y el sabor de pan disponible para esa fecha.</p>
        <a class="inline-link" href={whatsappMessageUrl("Hola, Bavette. Necesito revisar un pedido urgente para una fecha próxima.")} target="_blank" rel="noreferrer">
          Revisar una fecha por WhatsApp <span aria-hidden="true">↗</span>
          <span class="sr-only">(se abre en una pestaña nueva)</span>
        </a>
      </aside>
    </section>

    <section class="order-section" id="encargos" aria-labelledby="order-title">
      <div class="order-copy">
        <p class="eyebrow">Tu idea, nuestro horno</p>
        <h2 id="order-title">Hagamos algo especial.</h2>
        <p>
          Escríbenos directamente por WhatsApp Business para solicitar disponibilidad y cotización.
        </p>
        <ol class="order-flow">
          <li><strong>Cuéntanos</strong><span>Qué quieres celebrar y para qué fecha.</span></li>
          <li><strong>Define</strong><span>Sabores, porciones, diseño y entrega.</span></li>
          <li><strong>Aparta</strong><span>Recibe confirmación y cubre el 50% de anticipo.</span></li>
        </ol>
      </div>

      <div class="order-whatsapp-card">
        <div class="order-whatsapp-heading">
          <div>
            <p class="eyebrow">Canal de pedidos</p>
            <h3>Todo empieza en un mensaje.</h3>
          </div>
          <span class="order-whatsapp-mark" aria-hidden="true">↗</span>
        </div>
        <p>
          Cuéntanos qué quieres celebrar, para qué fecha, cuántas personas son y cualquier detalle que tengas en mente.
        </p>
        <a class="button button-accent" href={whatsappOrderUrl} target="_blank" rel="noreferrer">
          Abrir WhatsApp Business <span aria-hidden="true">↗</span>
          <span class="sr-only">(se abre en una pestaña nueva)</span>
        </a>
        <p class="order-whatsapp-note">Respondemos en aproximadamente una hora. Para apartar la fecha se requiere un anticipo del 50%.</p>
      </div>
    </section>

    <section class="practical-section" id="entrega" aria-labelledby="practical-title">
      <div class="section-heading compact">
        <div>
          <p class="eyebrow eyebrow-dark">Antes de confirmar</p>
          <h2 id="practical-title">Lo práctico, sin vueltas.</h2>
        </div>
        <p>Queremos que tengas claras las condiciones antes de apartar tu fecha.</p>
      </div>

      <dl class="facts-grid">
        {facts.map(([term, description]) => (
          <div>
            <dt>{term}</dt>
            <dd>{description}</dd>
          </div>
        ))}
      </dl>

      <div class="practical-details">
        <article>
          <h3>Entrega y transporte</h3>
          <p>{site.delivery}. Nosotras transportamos tu pastel. Si prefieres hacerlo tú, te compartimos las instrucciones necesarias.</p>
        </article>
        <article>
          <h3>Cambios y cancelaciones</h3>
          <p>Se aceptan únicamente 48 horas antes de la fecha. Para bodas o XV años, una semana antes del evento.</p>
        </article>
        <article>
          <h3>Pedidos no recogidos</h3>
          <p>El anticipo no es reembolsable cuando un pedido no es recogido o no puede entregarse por causas atribuibles al cliente.</p>
        </article>
      </div>
    </section>

    <section class="faq-section" id="preguntas" aria-labelledby="faq-title">
      <div class="faq-heading">
        <p class="eyebrow eyebrow-dark">Preguntas frecuentes</p>
        <h2 id="faq-title">Antes de encender el horno.</h2>
        <p>Si tu duda no aparece aquí, escríbenos y la resolvemos contigo.</p>
      </div>
      <div class="faq-list">
        {faqs.map(([question, answer]) => (
          <details>
            <summary>{question}<span aria-hidden="true">+</span></summary>
            <p>{answer}</p>
          </details>
        ))}
      </div>
    </section>

    <section class="contact-section" id="contacto" aria-labelledby="contact-title">
      <p class="eyebrow eyebrow-dark">Ciudad Obregón, Sonora</p>
      <h2 id="contact-title">Cuéntanos qué<br /><em>quieres celebrar.</em></h2>
      <p>Respondemos por WhatsApp Business en aproximadamente una hora.</p>
      <div class="contact-actions">
        <a class="button button-dark" href={whatsappOrderUrl} target="_blank" rel="noreferrer">
          Escribir por WhatsApp <span aria-hidden="true">↗</span>
          <span class="sr-only">(se abre en una pestaña nueva)</span>
        </a>
        <a class="button button-outline-dark" href={`mailto:${site.email}`}>Enviar correo</a>
      </div>
      <address>
        {site.address}<br />{site.hours}<br />{site.phoneDisplay}<br /><a href={`mailto:${site.email}`}>{site.email}</a>
      </address>
    </section>
  </main>

  <a class="mobile-order" href={whatsappOrderUrl} target="_blank" rel="noreferrer">
    Pedir por WhatsApp <span aria-hidden="true">↗</span>
    <span class="sr-only">(se abre en una pestaña nueva)</span>
  </a>
  <Footer />
</Layout>
