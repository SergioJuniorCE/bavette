---
import { whatsappOrderUrl } from "../data/site";

const home = Astro.url.pathname === "/" ? "" : "/";
---

<header class="site-header">
  <nav class="nav-shell" aria-label="Navegación principal">
    <a class="brand" href={`${home}#inicio`} aria-label="Bavette, inicio">
      <span class="brand-name">Bavette</span>
      <span class="brand-detail">Repostería y snacks</span>
    </a>

    <div class="desktop-nav">
      <a href={`${home}#menu`}>Menú</a>
      <a href={`${home}#sabores`}>Sabores</a>
      <a href={`${home}#encargos`}>Cómo pedir</a>
      <a href={`${home}#contacto`}>Contacto</a>
    </div>

    <button class="theme-toggle" type="button" aria-pressed="false" aria-label="Cambiar al tema oscuro">
      <span class="theme-toggle-mark" aria-hidden="true"></span>
      <span class="theme-toggle-label">Tema</span>
    </button>

    <a class="nav-cta" href={whatsappOrderUrl} target="_blank" rel="noreferrer">
      Pedir por WhatsApp
      <span aria-hidden="true">↗</span>
      <span class="sr-only">(se abre en una pestaña nueva)</span>
    </a>

    <details class="mobile-nav">
      <summary aria-label="Abrir menú">Menú</summary>
      <div>
        <a href={`${home}#menu`}>Menú</a>
        <a href={`${home}#sabores`}>Sabores</a>
        <a href={`${home}#encargos`}>Cómo pedir</a>
        <a href={`${home}#preguntas`}>Preguntas frecuentes</a>
        <a href={`${home}#contacto`}>Contacto</a>
      </div>
    </details>
  </nav>
</header>

<script>
  const toggle = document.querySelector<HTMLButtonElement>(".theme-toggle");
  const root = document.documentElement;

  const updateThemeToggle = () => {
    if (!toggle) return;
    const isDark = root.dataset.theme === "dark";
    const nextTheme = isDark ? "claro" : "oscuro";
    toggle.setAttribute("aria-pressed", String(isDark));
    toggle.setAttribute("aria-label", `Cambiar al tema ${nextTheme}`);
  };

  updateThemeToggle();

  toggle?.addEventListener("click", () => {
    const theme = root.dataset.theme === "dark" ? "light" : "dark";
    root.dataset.theme = theme;
    root.style.colorScheme = theme;
    localStorage.setItem("bavette-theme", theme);
    document.querySelector("#theme-color")?.setAttribute(
      "content",
      theme === "dark" ? "#201a19" : "#fcfbf7",
    );
    updateThemeToggle();
  });
</script>
